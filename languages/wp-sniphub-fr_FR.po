#: wp-sniphub.php:66
msgid "Base Configuration"
msgstr "Configuration de base"

#: wp-sniphub.php:67
msgid "Initial site configuration and dependencies."
msgstr "Configuration initiale et dépendances du site."

#: wp-sniphub.php:68
msgid "Handles the site's basic settings, required dependencies, and global configuration."
msgstr "Ce module gère les paramètres de base, les dépendances nécessaires et les configurations globales du site."

#: wp-sniphub.php:73
msgid "Scripts"
msgstr "Scripts"

#: wp-sniphub.php:74
msgid "Script management."
msgstr "Gestion des scripts."

#: wp-sniphub.php:75
msgid "Loads global JS files and optimizes their loading for specific pages."
msgstr "Permet de charger les fichiers JS globaux et d'optimiser leur chargement en fonction de pages spécifiques."

#: wp-sniphub.php:80
msgid "Styles"
msgstr "Styles"

#: wp-sniphub.php:81
msgid "Style management."
msgstr "Gestion des styles."

#: wp-sniphub.php:82
msgid "Loads CSS files and optimizes their loading for specific pages."
msgstr "Permet de charger les fichiers CSS et d'optimiser leur chargement en fonction de pages spécifiques."

#: wp-sniphub.php:87
msgid "Custom Post Types"
msgstr "Types de contenu personnalisés"

#: wp-sniphub.php:88
msgid "Defines Custom Post Types (CPT)."
msgstr "Définition des Custom Post Types (CPT)."

#: wp-sniphub.php:89
msgid "Adds and configures specific content types (e.g. Portfolio, Recipes, etc.)."
msgstr "Ajoute et configure des types de contenu spécifiques (ex : Portfolio, Recettes, etc.)."

#: wp-sniphub.php:94
msgid "Custom Taxonomies"
msgstr "Définition des taxonomies personnalisées"

#: wp-sniphub.php:95
msgid "Defines custom taxonomy types."
msgstr "Définition des types de taxonomies personnalisées."

#: wp-sniphub.php:96
msgid "Adds and configures custom taxonomy types for Custom Post Types: categories and/or tags."
msgstr "Ajoute et configure des types de taxonomies personnalisées aux Custom Post Types : des catégories et/ou des étiquettes."

#: wp-sniphub.php:101
msgid "Useful Shortcodes"
msgstr "Ajout de codes courts utiles pour le site"

#: wp-sniphub.php:102
msgid "Create shortcodes whose output is displayed on the site."
msgstr "Créer des codes courts dont la fonction sera affichée sur le site."

#: wp-sniphub.php:103
msgid "Adds custom shortcodes (e.g. automatically display the current year in the footer)."
msgstr "Permet de créer des codes courts (ex : Afficher l'année en cours automatiquement dans le footer)."

#: wp-sniphub.php:108
msgid "Backend / Frontend Hardening"
msgstr "Ajout de sécurisations backend / frontend"

#: wp-sniphub.php:109
msgid "Adds backend / frontend security hardening."
msgstr "Ajout de sécurisations backend / frontend."

#: wp-sniphub.php:110
msgid "Adds security measures not natively present in WordPress (e.g. blocking file editing)."
msgstr "Permet d'ajouter des sécurités à WordPress, non présentes nativement (ex : Bloquer l'édition de fichiers)."

#: wp-sniphub.php:115
msgid "Custom Image Sizes"
msgstr "Ajout de tailles d'images personnalisées"

#: wp-sniphub.php:116
msgid "Adds extra custom image sizes."
msgstr "Ajouter des tailles d'images supplémentaires et personnalisées."

#: wp-sniphub.php:117
msgid "Adds image sizes not natively available in WordPress (e.g. Full HD size - 1920x1080px)."
msgstr "Permet de créer de tailles d'images à WordPress, non présentes nativement (ex : Taille Full HD - 1920px x 1080px)."

#: wp-sniphub.php:122
msgid "Disable Native Features"
msgstr "Désactivation de certaines fonctions natives"

#: wp-sniphub.php:123
msgid "Disables certain WordPress features."
msgstr "Désactiver certaines fonctions de WordPress."

#: wp-sniphub.php:124
msgid "Disables features not needed by the site (e.g. disabling emojis, disabling Duotone SVG filters)."
msgstr "Permet de désactiver des fonctions non utiles au site (ex : Désactiver les emojis, désactiver les filtres SVG Duotone)."

#: wp-sniphub.php:129
msgid "Custom Hooks and Filters"
msgstr "Hooks et filtres personnalisés"

#: wp-sniphub.php:130
msgid "Adds custom hooks and filters."
msgstr "Ajout de hooks et filtres personnalisés."

#: wp-sniphub.php:131
msgid "Adds custom PHP hooks and filters (e.g. browser tab notification)."
msgstr "Permet d'ajouter des hooks et des filtres PHP personnalisés (ex : Notification dans la barre du navigateur)."

#: wp-sniphub.php:136
msgid "Utility Functions"
msgstr "Fonctions utilitaires"

#: wp-sniphub.php:137
msgid "Adds reusable utility functions."
msgstr "Ajoute des fonctions utilitaires réutilisables."

#: wp-sniphub.php:138
msgid "Adds reusable utility functions (e.g. retrieving a content excerpt)."
msgstr "Permet d'ajouter des fonctions utilitaires réutilisables (ex : Récupérer un extrait de contenu)."

#: wp-sniphub.php:143
msgid "WooCommerce Customization"
msgstr "Personnalisation de Woocommerce"

#: wp-sniphub.php:144
msgid "Adds functions to WooCommerce."
msgstr "Ajouter des fonctions à Woocommerce."

#: wp-sniphub.php:145
msgid "Adds/modifies WooCommerce functions (e.g. redirects, autofill)."
msgstr "Permet d'ajouter/modifier des fonctions à Woocommerce (ex : Redirections, Remplissage automatique)."

#: wp-sniphub.php:150
msgid "Post Functions"
msgstr "Ajout de fonctions pour les articles"

#: wp-sniphub.php:151
msgid "Adds functions to posts."
msgstr "Ajouter des fonctions aux articles."

#: wp-sniphub.php:152
msgid "Adds/modifies post functions (e.g. copyright notice, maximum word count for post titles)."
msgstr "Permet d'ajouter/modifier des fonctions aux articles (ex : Copyright, Nombre maximum de mots pour les titres de publications)."

#: wp-sniphub.php:157
msgid "Login Page Customization"
msgstr "Personnalisation de la page de connexion"

#: wp-sniphub.php:158
msgid "Customizes the login page appearance."
msgstr "Personnaliser l'apparence de la page de connexion."

#: wp-sniphub.php:159
msgid "Adds/modifies the login page appearance (e.g. background, colors, logo, etc.)."
msgstr "Permet d'ajouter/modifier l'apparence de la page de connexion (ex : Arrière-plan, couleurs, logo, etc.)."

#: wp-sniphub.php:164
msgid "Dashboard Interface Customization"
msgstr "Personnalisation de l'interface du Dashboard"

#: wp-sniphub.php:165
msgid "Customizes the Dashboard appearance."
msgstr "Personnaliser l'apparence du Dashboard."

#: wp-sniphub.php:166
msgid "Adds changes to the Dashboard (e.g. custom color palette, changing the Gravatar, footer text)."
msgstr "Permet d'ajouter des modifications au Dashboard (ex : Palette de couleurs personnalisée, changer le Gravatar, texte de pied de page)."

#: wp-sniphub.php:171
msgid "Additional Media Types"
msgstr "Ajout de types de médias"

#: wp-sniphub.php:172
msgid "Adds media types beyond jpeg, png, pdf, etc."
msgstr "Ajouter des médias autres que jpeg, png, pdf, etc."

#: wp-sniphub.php:173
msgid "Adds media types not natively supported by WordPress (e.g. SVG, JSON)."
msgstr "Permet d'ajouter des types de médias non pris en charge nativement par WordPress (ex : SVG, JSON)."

#: wp-sniphub.php:178
msgid "Gravity Forms Customization"
msgstr "Personnalisation du plugin Gravity Forms"

#: wp-sniphub.php:179
msgid "Customizes the Gravity Forms contact form plugin."
msgstr "Personnaliser le plugin de formulaire de contact Gravity Forms."

#: wp-sniphub.php:180
msgid "Adds/modifies plugin functions (e.g. disabling native CSS, fixing accessibility)."
msgstr "Permet d'ajouter/modifier des fonctions du plugin (ex : Désactiver les CSS natifs, corriger l'accessibilité)."

#: wp-sniphub.php:185
msgid "Custom Favicon Management"
msgstr "Gestion du favicon personnalisé"

#: wp-sniphub.php:186
msgid "Customizes favicon formats."
msgstr "Personnaliser les formats du favicon."

#: wp-sniphub.php:187
msgid "Adds additional favicons (e.g. ICO, SVG, dark mode)."
msgstr "Permet d'ajouter des favicons supplémentaires (ex : ICO, SVG, Darkmode)."

#: wp-sniphub.php:192
msgid "Performance Optimizations"
msgstr "Optimisations de performance"

#: wp-sniphub.php:193
msgid "Adds performance optimizations."
msgstr "Ajout d'optimisations de performance."

#: wp-sniphub.php:194
msgid "Adds/modifies functions to improve loading performance (e.g. disabling Speculative Loading, preloading above-the-fold images to improve LCP)."
msgstr "Permet d'ajouter/modifier des fonctions pour augmenter les performances de chargement (ex : Désactiver Speculative Loading, utiliser la pré-loading sur les images affichées au-dessus de la ligne de flottaison pour améliorer LCP)."

#: wp-sniphub.php:199
msgid "GreenShift Customization"
msgstr "Personnalisation du plugin GreenShift"

#: wp-sniphub.php:200
msgid "Adds functions to the GreenShift plugin."
msgstr "Ajout des fonctions au plugin GreenShift."

#: wp-sniphub.php:201
msgid "Adds/modifies GreenShift plugin functions (e.g. custom breakpoints, dark mode)."
msgstr "Permet d'ajouter/modifier des fonctions du plugin GreenShift (ex : Points de rupture personnalisés, Darkmode)."

